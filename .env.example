# Web runtime / public client configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
VITE_PUBLIC_APP_URL=https://YOUR_PUBLIC_APP_HOST
VITE_ROUTING_PROVIDER_URL=https://router.project-osrm.org
VITE_VAPID_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY

# Expo public client configuration
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Set this to the EAS project for the app you are building. Do not use a shared
# Consumer project ID for Business, Fleet, or KleenestOS.
EAS_PROJECT_ID=YOUR_APP_EAS_PROJECT_ID


# Google Mobile Ads.
# Android production IDs are source-controlled as safe public defaults.
# Set these only to override the compiled defaults. iOS remains on Google test
# inventory until iOS production IDs are configured.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_NATIVE_ANDROID_ID=
EXPO_PUBLIC_ADMOB_NATIVE_IOS_ID=
