{
  "openapi": "3.1.0",
  "info": {
    "title": "Kleenest Platform API",
    "version": "0.1.0",
    "description": "Kleenest restroom intelligence and recommendation API. Beta v1 contract."
  },
  "servers": [
    {
      "url": "https://ssgesjzdvdsqacdtasje.supabase.co/functions/v1/platform-api"
    }
  ],
  "tags": [
    {
      "name": "Recommendations",
      "description": "Ranked restroom recommendations."
    },
    {
      "name": "Places",
      "description": "Canonical Kleenest restroom place details."
    },
    {
      "name": "Service",
      "description": "Platform service status."
    },
    {
      "name": "Amenities",
      "description": "Canonical Kleenest amenity catalog and Smart Restroom capability."
    },
    {
      "name": "Smart Facilities",
      "description": "Provider-neutral Smart Device and connected-restroom integration."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "service": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "service",
                    "version"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/recommendations/nearby": {
      "post": {
        "tags": [
          "Recommendations"
        ],
        "summary": "Find nearby restroom recommendations",
        "security": [
          {
            "KleenestApiKey": []
          },
          {
            "KleenestClientToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NearbyRecommendationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked recommendations",
            "headers": {
              "X-Kleenest-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "X-RateLimit-Remaining-Minute": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining-Month": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden",
            "description": "Insufficient scope, inactive partner, missing Origin, or non-allowlisted Origin"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/recommendations/route": {
      "post": {
        "tags": [
          "Recommendations"
        ],
        "summary": "Find restroom recommendations along a route",
        "security": [
          {
            "KleenestApiKey": []
          },
          {
            "KleenestClientToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRecommendationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked route recommendations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden",
            "description": "Insufficient scope, inactive partner, missing Origin, or non-allowlisted Origin"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/places/{kleenestPlaceId}": {
      "get": {
        "tags": [
          "Places"
        ],
        "summary": "Get canonical Kleenest place details",
        "description": "Returns a sanitized public restroom/business detail record for a Kleenest place id.",
        "security": [
          {
            "KleenestApiKey": []
          },
          {
            "KleenestClientToken": []
          }
        ],
        "parameters": [
          {
            "name": "kleenestPlaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical place details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceDetails"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/places/match": {
      "post": {
        "tags": [
          "Places"
        ],
        "summary": "Match a partner place record to Kleenest",
        "description": "Read-only deterministic resolver. Returns a canonical match only when the leading candidate is strong and not ambiguous; otherwise candidates are returned for caller review.",
        "security": [
          {
            "KleenestApiKey": []
          },
          {
            "KleenestClientToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceMatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Match result and ranked candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceMatchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/amenities": {
      "get": {
        "tags": [
          "Amenities"
        ],
        "summary": "List canonical amenities",
        "security": [
          {
            "KleenestApiKey": []
          },
          {
            "KleenestClientToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Amenity catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "amenities": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Amenity"
                      }
                    },
                    "metadata": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v1/devices": {
      "get": {
        "tags": [
          "Smart Facilities"
        ],
        "summary": "List Smart Devices",
        "security": [
          {
            "KleenestApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Partner Smart Device manifest",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "Smart Facilities"
        ],
        "summary": "Register a Smart Device",
        "security": [
          {
            "KleenestApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "businessId",
                  "connectorId",
                  "externalDeviceId",
                  "name"
                ],
                "properties": {
                  "businessId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "connectorId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "externalDeviceId": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "locationId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uuid"
                  },
                  "deviceType": {
                    "type": "string"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "telemetryEnabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered Smart Device"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v1/devices/events": {
      "post": {
        "tags": [
          "Smart Facilities"
        ],
        "summary": "Ingest a normalized Smart Device event",
        "security": [
          {
            "KleenestApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "externalDeviceId",
                  "eventType"
                ],
                "properties": {
                  "externalDeviceId": {
                    "type": "string"
                  },
                  "eventType": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  },
                  "metric": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "valueNumeric": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "valueText": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "unit": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "payload": {
                    "type": "object"
                  },
                  "observedAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "dedupeKey": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Event accepted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v1/devices/{deviceId}/commands": {
      "post": {
        "tags": [
          "Smart Facilities"
        ],
        "summary": "Queue an audited Smart Device command",
        "security": [
          {
            "KleenestApiKey": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "deviceId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "command"
                ],
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "arguments": {
                    "type": "object"
                  },
                  "idempotencyKey": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Command queued or held for approval"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v1/devices/{deviceId}/commands/{commandId}/complete": {
      "post": {
        "tags": [
          "Smart Facilities"
        ],
        "summary": "Report Smart Device command completion",
        "security": [
          {
            "KleenestApiKey": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "deviceId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "commandId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "success"
                ],
                "properties": {
                  "success": {
                    "type": "boolean"
                  },
                  "result": {
                    "type": "object"
                  },
                  "error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completion recorded"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "KleenestApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-kleenest-api-key",
        "description": "Partner API key issued from the Kleenest Developer Portal."
      },
      "KleenestClientToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-kleenest-client-token",
        "description": "Publishable, origin-restricted browser/client token issued from the Kleenest Developer Portal."
      }
    },
    "schemas": {
      "GeoPoint": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "LineString": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "LineString"
          },
          "coordinates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5000,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "required": [
          "type",
          "coordinates"
        ]
      },
      "RecommendationRequirements": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "amenityNames": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 24
          },
          "amenityMatch": {
            "type": "string",
            "enum": [
              "all",
              "any"
            ]
          },
          "publicAccess": {
            "type": "boolean"
          },
          "wheelchairAccessible": {
            "type": "boolean"
          },
          "changingTable": {
            "type": "boolean"
          },
          "familyRestroom": {
            "type": "boolean"
          },
          "open24Hours": {
            "type": "boolean"
          },
          "smartRestroom": {
            "type": "boolean",
            "description": "Require the Connected / Smart Restroom amenity. Equivalent to requiring the canonical amenity name."
          }
        }
      },
      "NearbyRecommendationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "location": {
            "$ref": "#/components/schemas/GeoPoint"
          },
          "radiusMeters": {
            "type": "number",
            "minimum": 100,
            "maximum": 402336
          },
          "maxRadiusMeters": {
            "type": "number",
            "minimum": 100,
            "maximum": 402336
          },
          "search": {
            "type": "string"
          },
          "requirements": {
            "$ref": "#/components/schemas/RecommendationRequirements"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10
          }
        },
        "required": [
          "location",
          "radiusMeters"
        ]
      },
      "RouteRecommendationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "route": {
            "$ref": "#/components/schemas/LineString"
          },
          "corridorMeters": {
            "type": "number",
            "minimum": 100,
            "maximum": 40234,
            "default": 8047
          },
          "search": {
            "type": "string"
          },
          "requirements": {
            "$ref": "#/components/schemas/RecommendationRequirements"
          },
          "maxDetourMinutes": {
            "type": "number",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        },
        "required": [
          "route",
          "corridorMeters"
        ]
      },
      "PlaceIdentity": {
        "type": "object",
        "properties": {
          "kleenestPlaceId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "latitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "longitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "externalIds": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "kleenestPlaceId",
          "name",
          "latitude",
          "longitude"
        ]
      },
      "RecommendationCandidate": {
        "type": "object",
        "properties": {
          "place": {
            "$ref": "#/components/schemas/PlaceIdentity"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "trust": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "verificationStatus": {
                "type": "string"
              },
              "lastVerifiedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "observationCount": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "freshnessAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "required": [
              "confidence",
              "verificationStatus",
              "lastVerifiedAt",
              "observationCount",
              "freshnessAt"
            ]
          },
          "restroom": {
            "type": "object",
            "properties": {
              "publicAccess": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "wheelchairAccessible": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "changingTable": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "familyRestroom": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "open24Hours": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "amenityNames": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "smartRestroom": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "publicAccess",
              "wheelchairAccessible",
              "changingTable",
              "familyRestroom",
              "open24Hours",
              "amenityNames",
              "smartRestroom"
            ]
          },
          "distanceMeters": {
            "type": [
              "number",
              "null"
            ]
          },
          "distanceAheadMeters": {
            "type": [
              "number",
              "null"
            ]
          },
          "detourMinutes": {
            "type": [
              "number",
              "null"
            ]
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "explanation": {
            "type": "string"
          },
          "deepLink": {
            "type": "string",
            "format": "uri"
          },
          "source": {
            "const": "kleenest"
          }
        },
        "required": [
          "place",
          "score",
          "trust",
          "restroom",
          "distanceMeters",
          "distanceAheadMeters",
          "detourMinutes",
          "reasonCodes",
          "explanation",
          "deepLink",
          "source"
        ]
      },
      "RecommendationResponse": {
        "type": "object",
        "properties": {
          "recommendations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecommendationCandidate"
            }
          },
          "metadata": {
            "type": "object",
            "properties": {
              "requestedAt": {
                "type": "string",
                "format": "date-time"
              },
              "resultCount": {
                "type": "integer"
              },
              "expanded": {
                "type": "boolean"
              },
              "effectiveRadiusMeters": {
                "type": "number"
              },
              "attemptedRadiiMeters": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "requestedAt",
              "resultCount"
            ]
          }
        },
        "required": [
          "recommendations",
          "metadata"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "requestId": {
