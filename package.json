{
  "name": "kleenest-production",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "audit": "node scripts/production-authority-audit.mjs && node scripts/commerce-authority-audit.mjs && node scripts/workspace-authority-audit.mjs && node scripts/native-authority-audit.mjs",
    "native:typecheck": "npm run typecheck --workspace @kleenest/consumer-mobile",
    "native:start": "npm run start --workspace @kleenest/consumer-mobile",
    "native:android": "npm run android --workspace @kleenest/consumer-mobile",
    "native:ios": "npm run ios --workspace @kleenest/consumer-mobile"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-style-spec": "^24.3.0",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.3"
  }
}
