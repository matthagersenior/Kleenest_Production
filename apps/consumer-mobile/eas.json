{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EAS_PROJECT_ID": "22a65aa3-c615-4c4f-a34d-084babc28fd7"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EAS_PROJECT_ID": "22a65aa3-c615-4c4f-a34d-084babc28fd7"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "candidate": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EAS_PROJECT_ID": "22a65aa3-c615-4c4f-a34d-084babc28fd7",
        "KLEENEST_RELEASE_CHANNEL": "candidate",
        "EXPO_PUBLIC_OTA_CHANNEL": "consumer-candidate"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "consumer-candidate"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EAS_PROJECT_ID": "22a65aa3-c615-4c4f-a34d-084babc28fd7",
        "KLEENEST_RELEASE_CHANNEL": "production",
        "EXPO_PUBLIC_OTA_CHANNEL": "consumer-production"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "consumer-production"
    }
  },
  "submit": {
    "production": {
      "android": {},
      "ios": {}
    }
  }
}
