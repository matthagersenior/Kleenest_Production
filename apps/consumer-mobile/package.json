{
  "name": "@kleenest/consumer-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "eas:candidate:android": "eas build --platform android --profile candidate",
    "eas:development:android": "eas build --platform android --profile development",
    "eas:preview:android": "eas build --platform android --profile preview",
    "eas:production:android": "eas build --platform android --profile production",
    "ios": "expo run:ios",
    "prebuild:android": "expo prebuild --platform android --clean",
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "web:export": "expo export --platform web"
  },
  "dependencies": {
    "@kleenest/mobile-core": "0.1.0",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.17",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.15",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "expo-dev-client": "~57.0.16",
    "typescript": "~6.0.3"
  }
}
