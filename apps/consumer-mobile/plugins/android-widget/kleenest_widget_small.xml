<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:padding="12dp" android:background="@drawable/kleenest_widget_background"
 android:orientation="vertical">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="KLEENEST" android:textSize="16sp" android:textStyle="bold" android:textColor="#72F1AF"/>
 <TextView android:id="@+id/kleenest_widget_status" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:text="Open app to refresh nearby results"
  android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="2" />
 <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
 <TextView android:id="@+id/kleenest_widget_find" android:layout_width="wrap_content"
  android:layout_height="wrap_content" android:padding="8dp"
  android:text="Find restroom" android:textColor="#061C14" android:textStyle="bold"
  android:textSize="12sp" android:background="#75EAB2" android:clickable="true"/>
</LinearLayout>