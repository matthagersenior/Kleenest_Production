<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@drawable/kleenest_widget_background"
 android:padding="4dp" android:orientation="vertical" android:gravity="center_horizontal">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
  android:gravity="center" android:text="Kleenest" android:textStyle="bold"
  android:textColor="#72F1AF" android:textSize="10sp" android:singleLine="true"/>
 <TextView android:id="@+id/kleenest_widget_status" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:gravity="center"
  android:text="Nearby" android:textColor="#FFFFFF" android:textSize="8sp"
  android:singleLine="true" android:ellipsize="end"/>
 <TextView android:id="@+id/kleenest_widget_find" android:layout_width="match_parent"
  android:layout_height="0dp" android:layout_weight="1" android:minHeight="26dp"
  android:gravity="center" android:text="Find" android:textColor="#061C14"
  android:textSize="11sp" android:textStyle="bold" android:background="#75EAB2"
  android:clickable="true" android:contentDescription="Find nearby restrooms in Kleenest"/>
</LinearLayout>
