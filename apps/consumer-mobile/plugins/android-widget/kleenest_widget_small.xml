<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@drawable/kleenest_widget_background"
 android:orientation="vertical" android:padding="4dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
 android:orientation="horizontal" android:gravity="center_vertical">
 <ImageView android:layout_width="17dp" android:layout_height="17dp" android:src="@mipmap/ic_launcher"
  android:layout_marginEnd="3dp" android:contentDescription="Kleenest logo"/>
 <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
  android:text="Kleenest" android:textColor="#91F1CF" android:textSize="10sp"
  android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
</LinearLayout>
<TextView android:id="@+id/kleenest_widget_status"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
 android:layout_marginBottom="3dp" android:text="Change search area" android:textColor="#E0F4EA"
 android:textSize="8sp" android:maxLines="1" android:ellipsize="end"
 android:clickable="true" android:contentDescription="Change Kleenest widget search location"/>
<TextView android:id="@+id/kleenest_widget_find" android:layout_width="match_parent"
 android:layout_height="0dp" android:layout_weight="1" android:minHeight="22dp"
 android:layout_marginTop="3dp" android:gravity="center" android:text="Find&#10;restroom"
 android:textSize="10sp" android:textStyle="bold" android:textColor="#073028"
 android:background="@drawable/kleenest_widget_primary" android:clickable="true"
 android:contentDescription="Find nearby restrooms in Kleenest"/></LinearLayout>