<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@drawable/kleenest_widget_background"
 android:orientation="vertical" android:padding="6dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
 android:orientation="horizontal" android:gravity="center_vertical">
 <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@mipmap/ic_launcher"
  android:contentDescription="Kleenest logo"/>
 <TextView android:id="@+id/kleenest_widget_status" android:layout_width="0dp"
  android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp"
  android:text="Kleenest" android:textColor="#91F1CF" android:textStyle="bold" android:textSize="10sp" android:singleLine="true"/>
</LinearLayout>
<TextView android:id="@+id/kleenest_widget_find" android:layout_width="match_parent"
 android:layout_height="0dp" android:layout_weight="1" android:minHeight="24dp"
 android:layout_marginTop="4dp" android:gravity="center" android:text="Find restroom"
 android:textColor="#073028" android:textStyle="bold" android:textSize="10sp"
 android:background="@drawable/kleenest_widget_primary" android:clickable="true"/></LinearLayout>