<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@drawable/kleenest_widget_background"
 android:padding="7dp" android:orientation="vertical">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="Kleenest · Explore" android:textSize="12sp"
  android:textStyle="bold" android:textColor="#72F1AF" android:singleLine="true"/>
 <TextView android:id="@+id/kleenest_widget_status" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:text="Open app to refresh"
  android:textColor="#FFFFFF" android:textSize="9sp" android:singleLine="true"
  android:ellipsize="end"/>
 <TextView android:id="@+id/kleenest_widget_place_1"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:paddingTop="2dp" android:paddingBottom="2dp" android:text="Search nearby"
  android:textColor="#FFFFFF" android:textSize="10sp" android:singleLine="true"
  android:ellipsize="end" android:clickable="true"/>
 <TextView android:id="@+id/kleenest_widget_place_2"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:paddingTop="2dp" android:paddingBottom="2dp" android:text="Search nearby"
  android:textColor="#FFFFFF" android:textSize="10sp" android:singleLine="true"
  android:ellipsize="end" android:clickable="true"/>
 <TextView android:id="@+id/kleenest_widget_place_3"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:paddingTop="2dp" android:paddingBottom="2dp" android:text="Search nearby"
  android:textColor="#FFFFFF" android:textSize="10sp" android:singleLine="true"
  android:ellipsize="end" android:clickable="true"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
  android:layout_weight="1" android:orientation="horizontal" android:gravity="bottom">
  <TextView android:id="@+id/kleenest_widget_find" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="30dp" android:gravity="center"
   android:text="Map" android:textColor="#061C14" android:textStyle="bold"
   android:textSize="11sp" android:background="#75EAB2" android:clickable="true"
   android:contentDescription="Open restroom map"/>
  <TextView android:id="@+id/kleenest_widget_route" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="30dp"
   android:layout_marginStart="4dp" android:gravity="center" android:text="Routes"
   android:textColor="#061C14" android:textStyle="bold" android:textSize="11sp"
   android:background="#75EAB2" android:clickable="true"
   android:contentDescription="Open restroom routes"/>
  <TextView android:id="@+id/kleenest_widget_qr" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="30dp"
   android:layout_marginStart="4dp" android:gravity="center" android:text="QR"
   android:textColor="#061C14" android:textStyle="bold" android:textSize="11sp"
   android:background="#75EAB2" android:clickable="true"
   android:contentDescription="Open QR scanner"/>
 </LinearLayout>
</LinearLayout>
