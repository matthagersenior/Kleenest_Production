{
  "name": "Kleenest Mail",
  "short_name": "Kleenest Mail",
  "description": "First-party Kleenest personal and shared email inboxes.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#f5f8f6",
